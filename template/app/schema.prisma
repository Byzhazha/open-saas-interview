datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  email                     String?         @unique
  username                  String?         @unique
  isAdmin                   Boolean         @default(false)

  paymentProcessorUserId    String?         @unique
  lemonSqueezyCustomerPortalUrl String?     // You can delete this if you're not using Lemon Squeezy as your payments processor.
  subscriptionStatus        String?         // 'active', 'cancel_at_period_end', 'past_due', 'deleted'
  subscriptionPlan          String?         // 'hobby', 'pro'
  datePaid                  DateTime?
  credits                   Int             @default(3)
  aiRequestsInFlight        Int             @default(0)

  gptResponses              GptResponse[]
  contactFormMessages       ContactFormMessage[]
  tasks                     Task[]
  files                     File[]
  aiUsageLogs               AiUsageLog[]
  animations                Animation[]
  animationVideoJobs        AnimationVideoJob[]
}

model GptResponse {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  content                   String
  aiUsageLog                AiUsageLog?
}

model Author {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  displayName String
  email       String?
  bio         String?

  posts       Post[]
}

model Tag {
  id          String     @id @default(uuid())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  name        String     @unique
  slug        String     @unique

  posts       PostTag[]
}

model Post {
  id          String     @id @default(uuid())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  title       String
  slug        String     @unique
  excerpt     String
  content     String
  status      String     @default("draft")
  publishedAt DateTime?
  author      Author     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorId    String
  tags        PostTag[]

  @@index([status, publishedAt])
  @@index([authorId, updatedAt])
}

model PostTag {
  postId      String
  tagId       String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag         Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model AiUsageLog {
  id              String       @id @default(uuid())
  createdAt       DateTime     @default(now())
  completedAt     DateTime?
  user            User         @relation(fields: [userId], references: [id])
  userId          String
  operation       String
  idempotencyKey  String
  model           String       @default("gpt-3.5-turbo")
  status          String       @default("processing")
  promptTokens    Int          @default(0)
  completionTokens Int         @default(0)
  totalTokens     Int          @default(0)
  estimatedCostMicros Int      @default(0)
  errorCode       String?
  durationMs      Int?
  response        GptResponse? @relation(fields: [responseId], references: [id])
  responseId      String?      @unique

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

model CmsPublicationEvent {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  postId       String
  slug         String
  eventType    String
  status       String   @default("pending")
  attempts     Int      @default(0)
  availableAt  DateTime @default(now())
  processedAt  DateTime?
  errorMessage String?

  @@index([status, availableAt, createdAt])
  @@index([postId, createdAt])
}

model Animation {
  id          String                @id @default(uuid())
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  title       String
  htmlContent String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  videoJobs   AnimationVideoJob[]

  @@index([userId, updatedAt])
}

model AnimationVideoJob {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  animation       Animation @relation(fields: [animationId], references: [id], onDelete: Cascade)
  animationId     String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  format          String
  status          String    @default("queued")
  durationSeconds Int       @default(5)
  fps             Int       @default(30)
  attempts        Int       @default(0)
  maxAttempts     Int       @default(3)
  queueJobId      String?
  outputS3Key     String?
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?

  @@index([userId, createdAt])
  @@index([animationId, format, status])
}

model Task {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  description               String
  time                      String          @default("1")
  isDone                    Boolean         @default(false)
}

model File {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  name                      String
  type                      String
  s3Key                     String
}

model DailyStats {
  id                               Int             @id @default(autoincrement())
  date                             DateTime        @default(now()) @unique

  totalViews                       Int             @default(0)
  prevDayViewsChangePercent        String          @default("0")
  userCount                        Int             @default(0)
  paidUserCount                    Int             @default(0)
  userDelta                        Int             @default(0)
  paidUserDelta                    Int             @default(0)
  totalRevenue                     Float           @default(0)
  totalProfit                      Float           @default(0)

  sources                          PageViewSource[]
}

model PageViewSource {
  @@id([date, name])
  name                     String
  date                     DateTime        @default(now())

  dailyStats               DailyStats?     @relation(fields: [dailyStatsId], references: [id])
  dailyStatsId             Int?

  visitors                 Int
}

model Logs {
  id                       Int             @id @default(autoincrement())
  createdAt                DateTime        @default(now())

  message                  String
  level                    String
}

model ContactFormMessage {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  content                   String
  isRead                    Boolean         @default(false)
  repliedAt                 DateTime?
}
